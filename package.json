{
  "name": "atlas-duel",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8080",
    "build": "vite build && node scripts/vercel-output.mjs",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p workers/match/tsconfig.json --noEmit",
    "match:dev": "wrangler dev --config workers/match/wrangler.toml",
    "match:deploy": "wrangler deploy --config workers/match/wrangler.toml",
    "test": "node --experimental-strip-types --test src/lib/game/*.test.ts src/lib/map/*.test.ts src/lib/multiplayer/*.test.ts src/lib/music/*.test.ts",
    "locations:validate": "node --experimental-strip-types src/lib/game/validate-cli.ts",
    "locations:report": "node --experimental-strip-types src/lib/game/validate-cli.ts",
    "locations:dedupe": "node --experimental-strip-types src/lib/game/validate-cli.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "map:data": "node scripts/build-map-data.mjs",
    "test:game": "node --experimental-strip-types --test src/lib/game/*.test.ts src/lib/map/*.test.ts src/lib/multiplayer/*.test.ts src/lib/music/*.test.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.510.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.186.0",
    "tw-animate-css": "^1.3.4",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.20.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "wrangler": "^4.135.0"
  }
}
